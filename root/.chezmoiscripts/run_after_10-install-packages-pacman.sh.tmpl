#!/usr/bin/env bash

# {{ template "scripts-library" }}

# The following line is for ShellCheck to correctly identify the above include
true || source ../.chezmoitemplates/scripts-library

# Capability detection: this script only runs where pacman exists.
if ! type -P pacman >/dev/null 2>&1; then
  exit 0
fi

# Installed on every Arch machine (headless included).
readonly common_packages=(
  zsh
  tmux
  git
  curl
  wget
  unzip
  jq
  ripgrep
  fd
  base-devel
  # Editor
  neovim python-neovim lazygit tree-sitter-cli
)

# Only when desktop.enabled = true.
readonly desktop_packages=(
  # Window manager and desktop
  i3-wm
  dex
  dunst
  xss-lock
  i3lock
  network-manager-applet
  pasystray
  pipewire-pulse
  playerctl
  rofi
  i3blocks acpi lm_sensors sysstat bc alsa-utils
  imagemagick
  xclip
  flameshot
  terminus-font
  xorg-xrandr
  xorg-xset
  xorg-xrdb
  xorg-xinput
  kwallet
  polkit-kde-agent
  # Utilities
  lxappearance
  arandr
  kwalletmanager
  workrave
  # Theme and icons
  breeze
  breeze-gtk
  breeze-icons
  # Fonts
  noto-fonts-cjk ttf-firacode-nerd ttf-fira-sans ttf-nerd-fonts-symbols
  # Basic desktop applications
  konsole dolphin okular spectacle mpv nomacs feh
)

# Only when hardware.laptop = true.
readonly laptop_packages=(
  brightnessctl
  cpupower
  powertop
  power-profiles-daemon
)

wanted_packages=("${common_packages[@]}")

{{- if .storage.btrbk_proj_snapshots }}
wanted_packages+=(btrfs-progs btrbk)
{{- end }}

{{- if .desktop.enabled }}
wanted_packages+=("${desktop_packages[@]}")
{{-   if eq .desktop.terminal "ghostty" }}
wanted_packages+=(ghostty)
{{-   else if eq .desktop.terminal "alacritty" }}
wanted_packages+=(alacritty)
{{-   end }}
{{-   if eq .desktop.display_manager "greetd" }}
wanted_packages+=(greetd greetd-tuigreet xorg-xinit)
{{-   else if eq .desktop.display_manager "sddm" }}
wanted_packages+=(sddm)
{{-   end }}
{{-   if .desktop.fcitx5 }}
wanted_packages+=(fcitx5-im fcitx5-chinese-addons fcitx5-nord fcitx5-material-color)
{{-   end }}
{{-   if .desktop.keyd }}
wanted_packages+=(keyd)
{{-   end }}
{{- end }}

{{- if .hardware.laptop }}
wanted_packages+=("${laptop_packages[@]}")
{{- end }}

{{- if .hardware.bluetooth }}
wanted_packages+=(bluez blueman)
{{- end }}

{{- if .hardware.gpu_packages }}
wanted_packages+=({{ range .hardware.gpu_packages }}{{ . | quote }} {{ end }})
{{- end }}

{{- if .tools.tailscale }}
wanted_packages+=(tailscale)
{{- end }}

{{- if .tools.sing_box }}
wanted_packages+=(sing-box)
{{- end }}

{{- if .tools.ai_cli }}
wanted_packages+=(pi openai-codex)
{{- end }}

missing_packages=()
for package in "${wanted_packages[@]}"; do
  if ! package_is_installed "${package}"; then
    missing_packages+=("${package}")
  fi
done

if [[ ${#missing_packages[@]} -gt 0 ]]; then
  install_packages "${missing_packages[@]}"
fi
