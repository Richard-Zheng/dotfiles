#!/usr/bin/env bash

# {{ template "scripts-library" }}

# The following line is for ShellCheck to correctly identify the above include
true || source ../.chezmoitemplates/scripts-library

# Re-run whenever the GRUB drop-in template or boot flags change.
# template: {{ include "etc/default/grub.d/90-chezmoi.cfg.tmpl" | sha256sum }}
# video: {{ .boot.grub_cmdline_video }}
# swapfile_hibernation: {{ .boot.grub_swapfile_hibernation }}

# Clean up the pre-refactor host-named drop-in if present.
if [[ -f /etc/default/grub.d/90-carbon.cfg ]]; then
  log_task "Removing legacy /etc/default/grub.d/90-carbon.cfg"
  c sudo rm -f /etc/default/grub.d/90-carbon.cfg
fi

# Generate first, validate, compare, then replace so repeated runs are safe.
if [[ -f /boot/grub/grub.cfg ]] && command -v grub-mkconfig >/dev/null 2>&1; then
  candidate=$(mktemp /boot/grub/.chezmoi-grub.XXXXXX)
  trap 'rm -f "${candidate}"' EXIT
  log_task "Generating and validating /boot/grub/grub.cfg"
  c sudo grub-mkconfig -o "${candidate}"
  c sudo grub-script-check "${candidate}"
  if ! cmp -s "${candidate}" /boot/grub/grub.cfg; then
    c sudo install -m600 "${candidate}" /boot/grub/grub.cfg
  fi
fi
