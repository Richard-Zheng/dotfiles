#!/usr/bin/env bash

# {{ template "scripts-library" }}

# The following line is for ShellCheck to correctly identify the above include
true || source ../.chezmoitemplates/scripts-library

# Capability detection: this script only runs where apt-get exists.
if ! type -P apt-get >/dev/null 2>&1; then
  exit 0
fi

# Minimal CLI + editor base installed on every Debian/Ubuntu machine.
readonly common_packages=(
  zsh
  tmux
  git
  curl
  wget
  unzip
  jq
  ripgrep
  fd-find
  build-essential
  # Editor
  neovim python3-pynvim
)

# Only when desktop.enabled = true.
readonly desktop_packages=(
  # Window manager and desktop
  i3-wm
  dex
  dunst
  xss-lock
  i3lock
  network-manager-gnome
  pasystray
  pipewire-pulse
  playerctl
  rofi
  i3blocks acpi lm-sensors sysstat bc alsa-utils
  imagemagick
  xclip
  flameshot
  fonts-terminus
  x11-xserver-utils
  xinput
  gnome-keyring
  libsecret-tools
  # Utilities
  lxappearance
  arandr
  workrave
  # Theme and icons
  breeze breeze-gtk-theme breeze-icon-theme
  # Fonts
  fonts-noto-cjk fonts-firacode fonts-powerline
  # Basic desktop applications
  konsole dolphin okular mpv nomacs feh
)

# Only when hardware.laptop = true.
readonly laptop_packages=(
  brightnessctl
  powertop
  power-profiles-daemon
)

wanted_packages=("${common_packages[@]}")

{{- if .storage.btrbk_proj_snapshots }}
wanted_packages+=(btrfs-progs btrbk)
{{- end }}

{{- if .desktop.enabled }}
wanted_packages+=("${desktop_packages[@]}")
{{-   if eq .desktop.display_manager "sddm" }}
wanted_packages+=(sddm)
{{-   else if eq .desktop.display_manager "greetd" }}
wanted_packages+=(greetd xinit)
{{-   end }}
{{-   if .desktop.fcitx5 }}
wanted_packages+=(fcitx5 fcitx5-chinese-addons)
{{-   end }}
{{- end }}

{{- if .hardware.laptop }}
wanted_packages+=("${laptop_packages[@]}")
{{- end }}

{{- if .hardware.bluetooth }}
wanted_packages+=(bluez blueman)
{{- end }}

missing_packages=()
for package in "${wanted_packages[@]}"; do
  if ! package_is_installed "${package}"; then
    missing_packages+=("${package}")
  fi
done

if [[ ${#missing_packages[@]} -gt 0 ]]; then
  install_packages "${missing_packages[@]}"
fi
