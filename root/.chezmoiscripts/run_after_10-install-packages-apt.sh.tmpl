#!/usr/bin/env bash

# {{ template "scripts-library" }}

# The following line is for ShellCheck to correctly identify the above include
true || source ../.chezmoitemplates/scripts-library

# Capability detection: this script only runs where apt-get exists.
if ! type -P apt-get >/dev/null 2>&1; then
  exit 0
fi

# Installed on every machine (headless included).
# Note: package names differ from Arch; this is why each package manager has
# its own script instead of one shared list.
readonly common_packages=(
  zsh
  tmux
  git
  curl
  wget
  unzip
  jq
  ripgrep
  fd-find
  build-essential
  # Editor
  neovim python3-pynvim
  # btrfs tooling for the ~/proj snapshots.
  btrfs-progs
  btrbk
)

# Only when a graphical desktop is wanted.
readonly desktop_packages=(
  # Window manager and desktop
  i3-wm
  dex
  dunst
  xss-lock
  i3lock
  network-manager-gnome
  pasystray
  pipewire-pulse
  playerctl
  rofi
  i3blocks acpi lm-sensors sysstat bc alsa-utils
  imagemagick
  xclip
  flameshot
  fonts-terminus
  x11-xserver-utils
  xinput
  sddm
  # Utilities
  lxappearance
  arandr
  bluez
  blueman
  workrave
  # Theme and icons
  breeze breeze-gtk-theme breeze-icon-theme
  # Fonts
  fonts-noto-cjk fonts-firacode fonts-powerline
  # Input method
  fcitx5 fcitx5-chinese-addons
  # Basic desktop applications
  konsole dolphin okular mpv nomacs feh
)

# Laptop-only packages.
readonly laptop_packages=(
  brightnessctl
  powertop
  power-profiles-daemon
)

wanted_packages=("${common_packages[@]}")
{{- if not .is_headless }}
wanted_packages+=("${desktop_packages[@]}")
{{- end }}
{{- if eq .type "laptop" }}
wanted_packages+=("${laptop_packages[@]}")
{{- end }}

missing_packages=()
for package in "${wanted_packages[@]}"; do
  if ! package_is_installed "${package}"; then
    missing_packages+=("${package}")
  fi
done

if [[ ${#missing_packages[@]} -gt 0 ]]; then
  install_packages "${missing_packages[@]}"
fi
