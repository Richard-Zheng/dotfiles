#!/usr/bin/env bash

# {{ template "scripts-library" }}

# The following line is for ShellCheck to correctly identify the above include
true || source ../.chezmoitemplates/scripts-library

{{- /* Only manage services where systemd is actually PID 1; in containers
       (devcontainers, WSL without systemd) systemctl exists but fails. */ -}}
{{- if includeTemplate "is-running-with-systemd" . }}

{{- if not .is_headless }}

# Display manager and networking for the graphical desktop.
{{- if eq (get . "profile") "carbon" }}
# Enable the replacement for the next login without terminating a desktop.
if systemctl is-enabled --quiet sddm 2>/dev/null; then
  c sudo systemctl disable sddm
fi
for service in greetd NetworkManager;
{{- else }}
for service in sddm NetworkManager;
{{- end }} do
  if ! systemctl is-enabled --quiet "${service}" 2>/dev/null; then
    log_task "Enabling ${service}"
    c sudo systemctl enable "${service}"
  fi
done
{{- end }}

{{- if eq (get . "profile") "carbon" }}
for service in tailscaled bluetooth; do
  c sudo systemctl enable --now "$service"
done
# Runtime proxy configuration is generated separately by Documents/sb.
if [[ -s /etc/sing-box/config.json ]]; then
  c sudo sing-box check -C /etc/sing-box
  c sudo systemctl enable --now sing-box
fi
{{- end }}

# Keep the wall clock accurate; hardware clocks drift and nothing else on this
# system pulls time. The NTP pool is set in etc/systemd/timesyncd.conf.d.
if ! systemctl is-enabled --quiet systemd-timesyncd 2>/dev/null; then
  log_task "Enabling systemd-timesyncd"
  c sudo systemctl enable --now systemd-timesyncd
fi

{{- if eq .type "laptop" }}

if ! systemctl is-enabled --quiet power-profiles-daemon 2>/dev/null; then
  log_task "Enabling power-profiles-daemon"
  c sudo systemctl enable --now power-profiles-daemon.service
fi
{{- end }}

# keyd is used on physical workstations.
{{- if not .is_headless }}

if command -v keyd >/dev/null 2>&1; then
  if ! systemctl is-enabled --quiet keyd 2>/dev/null; then
    log_task "Enabling keyd"
    c sudo systemctl enable keyd
  fi
  # Reload so config changes take effect without a reboot.
  if systemctl is-active --quiet keyd; then
    c sudo keyd reload || c sudo systemctl restart keyd
  fi
fi
{{- end }}

{{- else }}

log_info "systemd is not running, skipping service setup"
{{- end }}
