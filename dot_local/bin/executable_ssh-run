#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: ssh-run HOST [ssh options...]" >&2
  exit 2
fi

HOST="$1"
shift

# Leverage native SSH parameter precedence rules for automatic overrides:
# 1. -F uses "Last match wins" -> Place default first so user-provided -F can override it.
# 2. -o uses "First match wins" -> Place defaults last so user-provided -o takes precedence.

exec ssh \
  -F /home/frain/.ssh/config \
  "$@" \
  -o BatchMode=yes \
  -o ConnectTimeout=10 \
  "$HOST" \
  'bash -se'
