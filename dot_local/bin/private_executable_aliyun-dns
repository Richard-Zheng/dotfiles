#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "alibabacloud_alidns20150109==4.6.1",
# ]
# ///

"""Small command-line client for Alibaba Cloud DNS."""

from __future__ import annotations

import argparse
import json
import os
import shlex
import sys
from pathlib import Path
from typing import Any

from alibabacloud_alidns20150109 import models as alidns_models
from alibabacloud_alidns20150109.client import Client as AlidnsClient
from alibabacloud_tea_openapi import models as open_api_models


ENV_FILE = Path(
    os.environ.get("ALIYUN_ENV_FILE", "~/.config/secrets/aliyun.env")
).expanduser()


def load_credentials() -> tuple[str, str]:
    """Load credentials from the environment, then the local env file."""
    values: dict[str, str] = {}
    if ENV_FILE.is_file():
        for raw_line in ENV_FILE.read_text().splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("export "):
                line = line[7:].lstrip()
            key, separator, raw_value = line.partition("=")
            if not separator:
                continue
            try:
                parsed = shlex.split(raw_value, comments=True, posix=True)
            except ValueError as error:
                raise RuntimeError(f"Invalid value in {ENV_FILE}: {error}") from error
            values[key.strip()] = parsed[0] if parsed else ""

    access_key_id = os.environ.get("ALIBABA_CLOUD_ACCESS_KEY_ID") or values.get(
        "ALIBABA_CLOUD_ACCESS_KEY_ID"
    )
    access_key_secret = os.environ.get(
        "ALIBABA_CLOUD_ACCESS_KEY_SECRET"
    ) or values.get("ALIBABA_CLOUD_ACCESS_KEY_SECRET")
    if not access_key_id or not access_key_secret:
        raise RuntimeError(
            "Aliyun credentials are missing. Set ALIBABA_CLOUD_ACCESS_KEY_ID and "
            "ALIBABA_CLOUD_ACCESS_KEY_SECRET, or run configure-aliyun-env."
        )
    return access_key_id, access_key_secret


def create_client() -> AlidnsClient:
    access_key_id, access_key_secret = load_credentials()
    config = open_api_models.Config(
        access_key_id=access_key_id,
        access_key_secret=access_key_secret,
        endpoint="alidns.cn-hangzhou.aliyuncs.com",
    )
    return AlidnsClient(config)


def list_domains(client: AlidnsClient) -> dict[str, Any]:
    domains: list[dict[str, Any]] = []
    page_number = 1
    page_size = 100
    while True:
        response = client.describe_domains(
            alidns_models.DescribeDomainsRequest(
                page_number=page_number, page_size=page_size
            )
        )
        batch = list(response.body.domains.domain or [])
        domains.extend(
            {
                "name": domain.domain_name,
                "id": domain.domain_id,
                "records": domain.record_count,
                "created": domain.create_time,
            }
            for domain in batch
        )
        total = response.body.total_count or len(domains)
        if not batch or len(domains) >= total:
            break
        page_number += 1
    return {"domains": domains}


def list_records(client: AlidnsClient, domain_name: str) -> dict[str, Any]:
    records: list[dict[str, Any]] = []
    page_number = 1
    page_size = 500
    while True:
        response = client.describe_domain_records(
            alidns_models.DescribeDomainRecordsRequest(
                domain_name=domain_name,
                page_number=page_number,
                page_size=page_size,
            )
        )
        batch = list(response.body.domain_records.record or [])
        records.extend(
            {
                "id": record.record_id,
                "rr": record.rr,
                "type": record.type,
                "value": record.value,
                "ttl": record.ttl,
                "status": record.status,
                "line": record.line,
                **(
                    {"priority": record.priority}
                    if record.priority is not None
                    else {}
                ),
            }
            for record in batch
        )
        total = response.body.total_count or len(records)
        if not batch or len(records) >= total:
            break
        page_number += 1
    return {"domain": domain_name, "records": records}


def add_record(client: AlidnsClient, args: argparse.Namespace) -> dict[str, Any]:
    request: dict[str, Any] = {
        "domain_name": args.domain,
        "rr": args.rr,
        "type": args.type.upper(),
        "value": args.value,
    }
    if args.ttl is not None:
        request["ttl"] = args.ttl
    response = client.add_domain_record(alidns_models.AddDomainRecordRequest(**request))
    return {"action": "add", "record_id": response.body.record_id}


def update_record(client: AlidnsClient, args: argparse.Namespace) -> dict[str, Any]:
    request: dict[str, Any] = {
        "record_id": args.record_id,
        "rr": args.rr,
        "type": args.type.upper(),
        "value": args.value,
    }
    if args.ttl is not None:
        request["ttl"] = args.ttl
    response = client.update_domain_record(
        alidns_models.UpdateDomainRecordRequest(**request)
    )
    return {"action": "update", "record_id": response.body.record_id}


def delete_record(client: AlidnsClient, record_id: str) -> dict[str, Any]:
    response = client.delete_domain_record(
        alidns_models.DeleteDomainRecordRequest(record_id=record_id)
    )
    return {"action": "delete", "record_id": response.body.record_id}


def set_record_status(
    client: AlidnsClient, record_id: str, enabled: bool
) -> dict[str, Any]:
    action = "enable" if enabled else "disable"
    response = client.set_domain_record_status(
        alidns_models.SetDomainRecordStatusRequest(
            record_id=record_id, status="Enable" if enabled else "Disable"
        )
    )
    return {"action": action, "record_id": response.body.record_id}


def print_table(rows: list[dict[str, Any]], columns: list[tuple[str, str]]) -> None:
    if not rows:
        print("No results.")
        return
    widths = {
        key: max(len(label), *(len(str(row.get(key, ""))) for row in rows))
        for key, label in columns
    }
    print("  ".join(label.ljust(widths[key]) for key, label in columns))
    print("  ".join("-" * widths[key] for key, _ in columns))
    for row in rows:
        print("  ".join(str(row.get(key, "")).ljust(widths[key]) for key, _ in columns))


def print_human(result: dict[str, Any]) -> None:
    if "domains" in result:
        print_table(
            result["domains"],
            [("name", "DOMAIN"), ("records", "RECORDS"), ("created", "CREATED")],
        )
    elif "records" in result:
        print_table(
            result["records"],
            [
                ("id", "ID"),
                ("rr", "RR"),
                ("type", "TYPE"),
                ("value", "VALUE"),
                ("ttl", "TTL"),
                ("status", "STATUS"),
            ],
        )
    else:
        past_tense = {
            "add": "Added",
            "update": "Updated",
            "delete": "Deleted",
            "enable": "Enabled",
            "disable": "Disabled",
        }
        print(f"{past_tense[result['action']]} DNS record {result['record_id']}.")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="aliyun-dns",
        description="Manage Alibaba Cloud DNS records. Credentials are read from the "
        "environment or ~/.config/secrets/aliyun.env.",
        epilog="Add --json anywhere for machine-readable output.",
    )
    parser.add_argument(
        "--json", action="store_true", help="print machine-readable JSON"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("domains", help="list managed domains")

    records = subparsers.add_parser("records", help="list a domain's DNS records")
    records.add_argument("domain", help="domain name, for example example.com")

    add = subparsers.add_parser("add", help="add a DNS record")
    add.add_argument("domain", help="domain name")
    add.add_argument("rr", help='host record, such as "www" or "@"')
    add.add_argument("type", help="record type, such as A, AAAA, CNAME, or TXT")
    add.add_argument("value", help="record value")
    add.add_argument("--ttl", type=int, help="TTL in seconds")

    update = subparsers.add_parser("update", help="update a DNS record")
    update.add_argument("record_id", help="record ID shown by the records command")
    update.add_argument("rr", help='host record, such as "www" or "@"')
    update.add_argument("type", help="record type")
    update.add_argument("value", help="new record value")
    update.add_argument("--ttl", type=int, help="TTL in seconds")

    for command, description in (
        ("delete", "delete a DNS record"),
        ("enable", "enable a DNS record"),
        ("disable", "disable a DNS record"),
    ):
        action = subparsers.add_parser(command, help=description)
        action.add_argument("record_id", help="record ID shown by the records command")

    return parser


def main(argv: list[str] | None = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    json_output = "--json" in raw_argv
    # argparse normally requires global options before a subcommand. Accept this
    # common output flag anywhere to make interactive and agent use less fussy.
    args = build_parser().parse_args([arg for arg in raw_argv if arg != "--json"])
    try:
        client = create_client()
        if args.command == "domains":
            result = list_domains(client)
        elif args.command == "records":
            result = list_records(client, args.domain)
        elif args.command == "add":
            result = add_record(client, args)
        elif args.command == "update":
            result = update_record(client, args)
        elif args.command == "delete":
            result = delete_record(client, args.record_id)
        elif args.command == "enable":
            result = set_record_status(client, args.record_id, True)
        else:
            result = set_record_status(client, args.record_id, False)
    except Exception as error:
        if json_output:
            print(json.dumps({"ok": False, "error": str(error)}), file=sys.stderr)
        else:
            print(f"aliyun-dns: error: {error}", file=sys.stderr)
        return 1

    if json_output:
        print(json.dumps({"ok": True, **result}, ensure_ascii=False, indent=2))
    else:
        print_human(result)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
