{{- if .enable_snapper -}}
#!/bin/bash

# Trigger an update when either managed Snapper config changes.
# home: {{ include "private_dot_config/snapper/home" | sha256sum }}
# root: {{ include "private_dot_config/snapper/root" | sha256sum }}

set -euo pipefail

echo "Checking Snapper configuration updates..."

# Safety check: Ensure the binary exists and the destination directory is valid
if command -v snapper >/dev/null 2>&1 && [ -d /etc/snapper/configs ]; then
    for config_name in home root; do
        src={{ joinPath .chezmoi.sourceDir "private_dot_config/snapper" | quote }}/$config_name
        echo "Applying config: $config_name to /etc/snapper/configs/"

        # 'install' is safer than 'cp': it sets ownership and permissions in one go
        # -m 644: root read/write, others read
        # -o root -g root: ensures system-level ownership
        sudo install -m 644 -o root -g root "$src" "/etc/snapper/configs/$config_name"
    done
fi

{{- end -}}
