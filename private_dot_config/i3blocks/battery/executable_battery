#
# This script is meant to use with i3blocks. It reads the battery status,
# charge percentage, and power draw from sysfs (/sys/class/power_supply/BAT*),
# and optionally the remaining time from the "acpi" command.
#
# The color will gradually change for a percentage below 85%, and the urgency
# (exit code 33) is set if there is less than 5% remaining.

use strict;
use warnings;
use utf8;

my $status;
my $percent;
my $full_text;
my $short_text;
my $label = $ENV{LABEL} || "";

# 1. Dynamically find the first existing battery directory in sysfs
my @bat_dirs = sort glob("/sys/class/power_supply/BAT*");
my $sysfs_bat = $bat_dirs[0];

# Exit silently if no battery exists
if (not defined($sysfs_bat)) {
    exit(0);
}

# 2. Read status and charge percentage from sysfs. This is authoritative and
#    avoids the numbering mismatch between sysfs (BAT1) and the "acpi" tool
#    ("Battery 0").
open(my $status_fh, '<', "$sysfs_bat/status") or exit(0);
$status = <$status_fh>;
close($status_fh);
chomp($status);

open(my $cap_fh, '<', "$sysfs_bat/capacity") or exit(0);
$percent = <$cap_fh>;
close($cap_fh);
chomp($percent);

# fail on unexpected output
if (not defined($status) or $status !~ /^\S/ or
    not defined($percent) or $percent !~ /^\d+$/) {
    exit(0);
}

$full_text = "$label$percent%";

if ($status eq 'Discharging') {
    $full_text .= ' DIS';
} elsif ($status eq 'Charging') {
    $full_text .= ' CHR';
} elsif ($status eq 'Unknown') {
    # Fall back to the AC adapter state to decide between charge/discharge.
    if (open(my $adapter_fh, '-|', 'acpi', '-a')) {
        my $ac_adapt = <$adapter_fh>;
        close($adapter_fh);

        if (defined $ac_adapt and $ac_adapt =~ /: ([\w-]+)/) {
            my $state = $1;

            if ($state eq 'on-line') {
                $full_text .= ' CHR';
            } elsif ($state eq 'off-line') {
                $full_text .= ' DIS';
            }
        }
    }
}

my $watts = "";

# 3. Calculate Watts using the exact sysfs path we found earlier
my $power_now_file = "$sysfs_bat/power_now";
my $current_now_file = "$sysfs_bat/current_now";
my $voltage_now_file = "$sysfs_bat/voltage_now";

if (open(my $fh, '<', $power_now_file)) {
    my $micro_watts = <$fh>;
    close($fh);
    chomp($micro_watts);
    if (defined $micro_watts && $micro_watts =~ /^\d+$/ && $micro_watts > 0) {
        $watts = sprintf("%.1f W", $micro_watts / 1000000);
    }
} elsif (open(my $fh_c, '<', $current_now_file) && open(my $fh_v, '<', $voltage_now_file)) {
    my $micro_amps = <$fh_c>;
    my $micro_volts = <$fh_v>;
    close($fh_c);
    close($fh_v);
    chomp($micro_amps);
    chomp($micro_volts);
    if (defined $micro_amps && $micro_amps =~ /^\d+$/ && defined $micro_volts && $micro_volts =~ /^\d+$/) {
        # P = V * I (microAmps * microVolts / 10^12 = Watts)
        $watts = sprintf("%.1f W", ($micro_amps * $micro_volts) / 1000000000000);
    }
}

if ($watts ne "") {
    $full_text .= " $watts";
}

$short_text = $full_text;

# 4. Optionally append the remaining-time estimate from the "acpi" tool.
#    This is purely cosmetic; ignore it if acpi is missing or fails.
if (open(my $acpi_fh, '-|', 'acpi', '-b')) {
    my $acpi_line = <$acpi_fh>;
    close($acpi_fh);
    if (defined $acpi_line and $acpi_line =~ /(\d\d:\d\d):/) {
        $full_text .= " ($1)";
    }
}

# print text
print "$full_text\n";
print "$short_text\n";

# consider color and urgent flag only on discharge
if ($status eq 'Discharging') {

    if ($percent < 20) {
        print "#FF0000\n";
    } elsif ($percent < 40) {
        print "#FFAE00\n";
    } elsif ($percent < 60) {
        print "#FFF600\n";
    } elsif ($percent < 85) {
        print "#A8FF00\n";
    }

    if ($percent < 5) {
        exit(33);
    }
}

exit(0);
