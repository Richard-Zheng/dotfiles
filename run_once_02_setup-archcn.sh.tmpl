{{ if eq .chezmoi.osRelease.id "arch" -}}
#!/bin/bash

set -euo pipefail

echo "======================================================="
echo "Configuring Arch Linux CN repository..."
echo "======================================================="

# Check for an active archlinuxcn section, ignoring commented examples.
if ! grep -Eq '^[[:space:]]*\[archlinuxcn\][[:space:]]*$' /etc/pacman.conf; then
    echo " -> Appending [archlinuxcn] to /etc/pacman.conf..."
    # Add the NJU mirror for archlinuxcn
    cat << EOF | sudo tee -a /etc/pacman.conf

[archlinuxcn]
Server = https://mirrors.nju.edu.cn/archlinuxcn/\$arch
EOF

else
    echo " -> Arch Linux CN repository is already configured."
fi

echo " -> Upgrading the system and installing archlinuxcn-keyring..."
# Arch Linux does not support partial upgrades. Refresh databases, perform
# the full upgrade, and install the repository keyring in one transaction.
sudo pacman -Syu --needed --noconfirm archlinuxcn-keyring

echo " -> Arch Linux CN repository configured successfully!"

echo "======================================================="
echo "Arch Linux CN setup completed!"
echo "======================================================="

{{ end -}}
