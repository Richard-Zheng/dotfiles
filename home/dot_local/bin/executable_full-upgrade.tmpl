#!/usr/bin/env bash

# {{ template "scripts-library" }}
# {{ template "homebrew-library" }}

# The following lines are for ShellCheck to correctly identify the above includes
true || source ../../.chezmoitemplates/scripts-library
true || source ../../.chezmoitemplates/homebrew-library

# Update the dotfiles themselves, then every package manager and language
# runtime present on the machine. Each block is guarded by capability detection,
# so the same script works on Arch, Debian/Ubuntu and macOS.

ensure_path_entry "${HOME}/.local/bin"

# --- Dotfiles --------------------------------------------------------------
if command -v chezmoi >/dev/null 2>&1; then
  log_task "Updating dotfiles"
  dotfiles_old_hash="$(chezmoi git -- rev-parse HEAD 2>/dev/null || true)"

  if chezmoi git -- status --porcelain | grep -q .; then
    log_manual_action "Skipping chezmoi update: uncommitted changes found"
  else
    c chezmoi update --apply=false
  fi

  dotfiles_new_hash="$(chezmoi git -- rev-parse HEAD 2>/dev/null || true)"
  if [[ -n "${dotfiles_old_hash}" && "${dotfiles_old_hash}" != "${dotfiles_new_hash}" ]]; then
    log_green "📢 What's new?"
    PAGER="cat" chezmoi git -- log --oneline --no-decorate \
      --format="%C(yellow)%h%Creset %C(bold white)%s%Creset %C(dim)(%cr)%Creset" \
      "${dotfiles_old_hash}..${dotfiles_new_hash}" >&2
  fi
  unset dotfiles_old_hash dotfiles_new_hash

  c chezmoi init --force
  c chezmoi apply --force
fi

# --- Homebrew --------------------------------------------------------------
if type -P brew >/dev/null 2>&1; then
  (
    export HOMEBREW_NO_AUTO_UPDATE=1
    export HOMEBREW_NO_UPDATE_REPORT_NEW=1
    export HOMEBREW_NO_ENV_HINTS=1
    export HOMEBREW_NO_ASK=1
    log_task "Updating Homebrew"
    c brew update
    c brew upgrade
  )
fi

# --- System package managers ----------------------------------------------
if type -P pacman >/dev/null 2>&1; then
  log_task "Updating pacman packages"
  c sudo pacman -Syu --noconfirm
fi

if type -P apt-get >/dev/null 2>&1; then
  log_task "Updating apt packages"
  c sudo apt-get update
  c sudo env DEBIAN_FRONTEND=noninteractive apt-get full-upgrade --yes
  c sudo env DEBIAN_FRONTEND=noninteractive apt-get autoremove --yes
fi

if command -v flatpak >/dev/null 2>&1; then
  log_task "Updating flatpak packages"
  c flatpak update --user --assumeyes
  c sudo flatpak update --system --assumeyes
fi

# --- Language runtimes -----------------------------------------------------
if command -v uv >/dev/null 2>&1; then
  log_task "Updating uv"
  c uv self update
fi

if command -v npm >/dev/null 2>&1; then
  log_task "Updating npm packages"
  c npm update --global
fi

if command -v cargo >/dev/null 2>&1 && command -v cargo-install-update >/dev/null 2>&1; then
  log_task "Updating cargo packages"
  c cargo install-update --all
fi

log_green "✅ Full upgrade complete"
