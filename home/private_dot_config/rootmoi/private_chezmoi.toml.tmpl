{{- /*
Configuration for the root chezmoi instance ("rootmoi").

It lives in ~/.config/rootmoi/chezmoi.toml and is generated by the user-level
instance. The `[data]` section forwards every user-level flag table (`desktop`,
`display`, `hardware`, `boot`, `storage`, `system`, `tools`, `platform`, ...)
to the root templates, plus `non_root_user` and `non_root_home`.
*/ -}}

{{- $rootData := deepCopy . -}}
{{- $rootData = unset $rootData "chezmoi" -}}
{{- $rootData = set $rootData "non_root_user" .chezmoi.username -}}
{{- $rootData = set $rootData "non_root_home" .chezmoi.homeDir -}}

sourceDir = {{ joinPath .chezmoi.workingTree "root" | quote }}
destDir = "/"
verbose = true

# https://github.com/twpayne/chezmoi/issues/3257
pager = ""

[diff]
  exclude = ["scripts"]

[status]
  exclude = ["always"]

{{ dict "data" $rootData | toToml }}
