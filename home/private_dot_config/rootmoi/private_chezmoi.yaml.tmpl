{{- /*
Configuration for the root chezmoi instance ("rootmoi").

It lives in ~/.config/rootmoi/chezmoi.yaml and is generated by the user-level
instance. The `data` section forwards every user-level data value (platform
flags, machine type, ...) to the root templates, plus `non_root_user` so root
scripts know which account owns the files they touch.
*/ -}}

{{- $data := deepCopy . -}}
{{- $data = unset $data "chezmoi" -}}

sourceDir: "{{ joinPath .chezmoi.workingTree "root" }}"

destDir: "/"

verbose: true

# https://github.com/twpayne/chezmoi/issues/3257
pager: ""

diff:
  exclude:
    - scripts
status:
  exclude:
    - always

data:
  non_root_user: "{{ .chezmoi.username }}"
  non_root_home: "{{ .chezmoi.homeDir }}"
  {{- $data | toYaml | nindent 2 }}
