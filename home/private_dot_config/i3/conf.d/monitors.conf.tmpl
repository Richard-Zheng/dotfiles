# 显示器布局切换（由 chezmoi.toml [data.display] 生成：{{ .display.hdmi_output }} + {{ .display.dp_output }}）
# $mod+Ctrl+p    双屏 {{ .display.hdmi_output }} + {{ .display.dp_output }}
# $mod+Ctrl+h    仅 {{ .display.hdmi_output }}
# $mod+Ctrl+l    仅 {{ .display.dp_output }}
bindsym $mod+Ctrl+p exec --no-startup-id ~/.config/i3/monitor.sh dual
bindsym $mod+Ctrl+h exec --no-startup-id ~/.config/i3/monitor.sh hdmi
bindsym $mod+Ctrl+l exec --no-startup-id ~/.config/i3/monitor.sh dp
