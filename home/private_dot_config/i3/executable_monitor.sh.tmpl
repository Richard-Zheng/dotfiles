#!/bin/sh
# monitor.sh [dual|hdmi|dp]
#
# 直接用 xrandr 控制显示器布局（不依赖 autorandr）。
# 参数由 chezmoi.toml [data.display] 注入：
#   dual  双屏：{{ .display.hdmi_output }}(左,主) + {{ .display.dp_output }}(右)
#   hdmi  仅 {{ .display.hdmi_output }}
#   dp    仅 {{ .display.dp_output }}

{{- $width := index (splitList "x" .display.resolution) 0 }}

HDMI={{ .display.hdmi_output | quote }}
DP={{ .display.dp_output | quote }}
RES={{ .display.resolution | quote }}
HDMI_RATE={{ .display.hdmi_rate | quote }}
DP_RATE={{ .display.dp_rate | quote }}

apply_dual() {
    xrandr --output "$HDMI" --mode "$RES" --rate "$HDMI_RATE" --pos 0x0 --primary \
           --output "$DP"   --mode "$RES" --rate "$DP_RATE"   --pos {{ $width }}x0
}

apply_hdmi() {
    xrandr --output "$DP"   --off \
           --output "$HDMI" --mode "$RES" --rate "$HDMI_RATE" --pos 0x0 --primary
}

apply_dp() {
    xrandr --output "$HDMI" --off \
           --output "$DP"   --mode "$RES" --rate "$DP_RATE" --pos 0x0 --primary
}

case "${1:-}" in
    dual) apply_dual ;;
    hdmi) apply_hdmi ;;
    dp)   apply_dp ;;
    *)
        echo "usage: $(basename "$0") [dual|hdmi|dp]" >&2
        exit 1
        ;;
esac
