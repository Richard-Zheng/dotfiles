#!/usr/bin/env bash
# chezmoi:template:left-delimiter="# {{" right-delimiter=}}

# {{ template "scripts-library" }}

# The following line is for ShellCheck to correctly identify the above include
true || source ../.chezmoitemplates/scripts-library

rootmoi_path='# {{ joinPath .chezmoi.homeDir ".local/bin/rootmoi" }}'

# Forward the arguments the user passed to `chezmoi apply`, minus the ones that
# make no sense for the root instance (it always applies its own source).
original_args=(
  # {{ rest .chezmoi.args | quoteList | join " " }}
)
args=(apply)

# Allow skipping rootmoi entirely, e.g. in tests or on machines without root.
if [[ -n "${NO_ROOTMOI:-}" ]]; then
  exit 0
fi

skip_one_more=false
for i in "${!original_args[@]}"; do
  if [[ "${skip_one_more}" == true ]]; then
    skip_one_more=false
    continue
  fi

  if [[ "${original_args[i]}" == "-S" || "${original_args[i]}" == "--source" ]]; then
    skip_one_more=true
    continue
  fi

  if [[ "${original_args[i]}" == "-S="* || "${original_args[i]}" == "--source="* ]]; then
    continue
  fi

  # We always apply, so drop any --apply flags.
  if [[ "${original_args[i]}" == "-a" || "${original_args[i]}" == "-a="* ||
    "${original_args[i]}" == "--apply" || "${original_args[i]}" == "--apply="* ]]; then
    continue
  fi

  # rootmoi's config is generated by the user-level instance.
  if [[ "${original_args[i]}" == "--init" ]]; then
    continue
  fi

  # --one-shot is incompatible with apply.
  if [[ "${original_args[i]}" == "--one-shot" ]]; then
    continue
  fi

  # Drop positional arguments.
  if [[ "${original_args[i]}" != "-"* ]]; then
    continue
  fi

  args+=("${original_args[i]}")
done

log_task "Applying root dotfiles"
log_c "rootmoi" "${args[@]}"
exec "${rootmoi_path}" "${args[@]}"
