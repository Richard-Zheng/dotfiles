{{- /*
Machine configuration template for chezmoi (~/.config/chezmoi/chezmoi.toml).

Each machine has a fine-grained flag file under hosts/<hostname>.toml at the
repository root. On `chezmoi init`, this template selects the matching host
file and renders it verbatim into ~/.config/chezmoi/chezmoi.toml along with
chezmoi settings and auto-detected [data.platform] flags.

Host selection order:
  1. $CHEZMOI_HOST environment variable (explicit override, e.g. for testing)
  2. hosts/<.chezmoi.hostname>.toml if it exists
  3. Interactive prompt over hosts/*.toml when stdin is a TTY
  4. hosts/default.toml fallback (CI, containers, non-interactive init)
*/ -}}

{{- $hostsDir := joinPath .chezmoi.workingTree "hosts" -}}
{{- $hostFiles := glob (joinPath $hostsDir "*.toml") -}}
{{- $availableHosts := list -}}
{{- range $f := $hostFiles -}}
{{-   $availableHosts = append $availableHosts (base $f | trimSuffix ".toml") -}}
{{- end -}}
{{- $availableHosts = sortAlpha $availableHosts -}}

{{- $host := "" -}}
{{- $envHost := env "CHEZMOI_HOST" -}}
{{- if $envHost -}}
{{-   if not (stat (joinPath $hostsDir (printf "%s.toml" $envHost))) -}}
{{-     fail (printf "CHEZMOI_HOST=%q does not match any file in %s (available: %s)" $envHost $hostsDir (join ", " $availableHosts)) -}}
{{-   end -}}
{{-   $host = $envHost -}}
{{- else if stat (joinPath $hostsDir (printf "%s.toml" .chezmoi.hostname)) -}}
{{-   $host = .chezmoi.hostname -}}
{{- else -}}
{{-   $defaultHost := "default" -}}
{{-   if and (hasKey . "host") (stat (joinPath $hostsDir (printf "%s.toml" .host))) -}}
{{-     $defaultHost = .host -}}
{{-   end -}}
{{-   if stdinIsATTY -}}
{{-     $host = promptChoiceOnce . "host" "Machine config (hosts/*.toml)" $availableHosts $defaultHost -}}
{{-   else -}}
{{-     $host = $defaultHost -}}
{{-   end -}}
{{- end -}}

{{- $hostFile := joinPath $hostsDir (printf "%s.toml" $host) -}}
{{- $hostContent := include $hostFile | trimSuffix "\n" -}}

{{- /* Platform detection, computed once and exported via [data.platform]. */ -}}
{{- $os := .chezmoi.os -}}
{{- $isLinux := eq $os "linux" -}}
{{- $isMac := eq $os "darwin" -}}
{{- $isArch := false -}}
{{- $isDebian := false -}}
{{- if and $isLinux (hasKey .chezmoi.osRelease "id") -}}
{{-   $isArch = eq .chezmoi.osRelease.id "arch" -}}
{{-   $isDebian = or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian") -}}
{{- end -}}

{{- $isContainer := false -}}
{{- if or
      (stat "/.dockerenv")
      (stat "/run/.containerenv")
      (env "REMOTE_CONTAINERS")
      (env "CODESPACES")
      (env "GITPOD_HOST")
      (env "VSCODE_REMOTE_CONTAINERS_SESSION") -}}
{{-   $isContainer = true -}}
{{- end -}}

# Generated by chezmoi from hosts/{{ $host }}.toml.
# Edit hosts/{{ $host }}.toml and run `chezmoi init --apply` to update,
# or edit this file directly for temporary local overrides.

sourceDir = {{ .chezmoi.workingTree | quote }}
verbose = true
pager = ""

# age encryption for *.age files (secrets, tokens, ...).
encryption = "age"

[age]
  identity = "~/.config/chezmoi/key.txt"
  recipient = "age1lqezkj7ahmlpshcu7csna8zya0hwktrxs7q50f4djhup2n64zawqtr96fh"

[diff]
  exclude = ["scripts"]

[status]
  exclude = ["always"]

# =============================================================================
# Machine flags (from hosts/{{ $host }}.toml)
# =============================================================================
{{ $hostContent }}

# =============================================================================
# Auto-detected platform metadata (managed by .chezmoi.toml.tmpl)
# =============================================================================
[data.platform]
  is_linux = {{ $isLinux }}
  is_mac = {{ $isMac }}
  is_arch = {{ $isArch }}
  is_debian = {{ $isDebian }}
  is_container = {{ $isContainer }}
  host_file = {{ printf "hosts/%s.toml" $host | quote }}
  host_config_sha256 = {{ $hostContent | sha256sum | quote }}
